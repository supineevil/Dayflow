{
  "manifest_version": 3,
  "name": "Dayflow",
  "version": "0.1.0",
  "description": "A calm, focused view of your calendar and tasks.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Dayflow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "sidePanel",
    "identity",
    "alarms"
  ],
  "key": "",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
